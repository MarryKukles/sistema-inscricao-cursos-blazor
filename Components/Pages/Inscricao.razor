@page "/inscricao"
@using SistemaInscricaoCursosBlazor.Components.Models

<PageTitle>Inscrição | Cursos Online</PageTitle>

<div class="page-container">
    <section class="form-card">
        <div class="form-heading">
            <span class="eyebrow">VAMOS COMEÇAR?</span>
            <h1>Inscreva-se em um curso</h1>
            <p>Preencha seus dados abaixo. Todos os campos são obrigatórios.</p>
        </div>

        <EditForm Model="modelo"
                  FormName="InscricaoForm"
                  OnValidSubmit="EnviarInscricaoAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="form-group">
                <label for="nome">Nome completo</label>
                <InputText id="nome" class="form-control"
                           @bind-Value="modelo.Nome"
                           placeholder="Digite seu nome completo" />
                <ValidationMessage For="@(() => modelo.Nome)" />
            </div>

            <div class="form-group">
                <label for="email">E-mail</label>
                <InputText id="email" class="form-control"
                           @bind-Value="modelo.Email"
                           placeholder="voce@exemplo.com"
                           type="email" />
                <ValidationMessage For="@(() => modelo.Email)" />
            </div>

            <div class="form-group">
                <label for="idade">Idade</label>
                <InputNumber id="idade" class="form-control"
                             @bind-Value="modelo.Idade"
                             placeholder="Ex.: 22" />
                <ValidationMessage For="@(() => modelo.Idade)" />
            </div>

            <div class="form-group">
                <label for="curso">Curso desejado</label>
                <InputSelect id="curso" class="form-control" @bind-Value="modelo.CursoId">
                    <option value="">Selecione um curso</option>
                    <option value="1">Desenvolvimento Web</option>
                    <option value="2">Lógica de Programação</option>
                    <option value="3">Banco de Dados</option>
                </InputSelect>
                <ValidationMessage For="@(() => modelo.CursoId)" />
            </div>

            <button class="submit-button" type="submit" disabled="@enviando">
                @(enviando ? "Processando..." : "Confirmar inscrição")
            </button>

            @if (enviando)
            {
                <p class="status-message processing">Enviando seus dados. Aguarde um instante...</p>
            }

            @if (sucesso)
            {
                <div class="success-message" role="status">
                    <strong>Inscrição realizada com sucesso!</strong>
                    <span>Obrigado, @modelo.Nome. Seus dados foram validados e enviados.</span>
                </div>
            }
        </EditForm>
    </section>
</div>

@code {
    [SupplyParameterFromForm]
    private InscricaoModel modelo { get; set; } = new();

    private bool enviando = false;
    private bool sucesso = false;

    private async Task EnviarInscricaoAsync()
    {
        sucesso = false;
        enviando = true;

        // Simula uma chamada assíncrona a um serviço ou API.
        await Task.Delay(2000);

        enviando = false;
        sucesso = true;
    }
}
